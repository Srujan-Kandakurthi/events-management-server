PORT=3002
MONGODB_URL=''
ENV_TYPE=''

# App
APP_NAME='Service Edge'

# JWT — passwordless session (default 7 days)
JWT_SECRET='change-me-to-a-long-random-string'
JWT_EXPIRES_DAYS=7

# SMTP (Nodemailer)
SMTP_HOST='smtp.gmail.com'
SMTP_PORT=587
SMTP_USER=''
SMTP_PASS=''
SMTP_FROM='Service Edge <noreply@example.com>'

# OTP policy
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Admin app deep link in invite emails
ADMIN_PANEL_URL='http://localhost:8081'
